# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_BOT_USERNAME=your_bot_username

# Postgres
POSTGRES_PASSWORD=change_me

# AI providers
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Obsidian Local REST API on the laptop, exposed to the tailnet via `tailscale serve`.
# On the laptop: tailscale serve --bg --https=443 http://127.0.0.1:27123
OBSIDIAN_API_TOKEN=your_obsidian_rest_api_token
OBSIDIAN_API_URL=https://my-laptop.tailnet-name.ts.net
# MagicDNS hostname (must equal the host in OBSIDIAN_API_URL) and the laptop's Tailscale IP.
# Used by docker-compose extra_hosts so the container resolves the cert hostname over the tailnet.
OBSIDIAN_HOST=my-laptop.tailnet-name.ts.net
OBSIDIAN_TAILSCALE_IP=100.x.y.z
